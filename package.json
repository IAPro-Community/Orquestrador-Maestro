    "skill-library/MANIFEST.json",
    "skill-library/community-skills/",
    "tool-profiles/",
    "README.md"
  ],
  "scripts": {
    "audit": "node scripts/audit-dependencies.js audit",
    "outdated:all": "node scripts/audit-dependencies.js outdated",
    "pack:dry-run": "npm pack --dry-run",
    "test": "node scripts/run-tests.js",
    "test:smoke": "node scripts/test-smoke.js",
    "test:xkiro": "node scripts/test-xkiro.js",
    "verify:pr": "node scripts/verify-pr.js",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-public.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-skills.ps1",
    "bench:list": "node --import tsx benchmark-harness/src/cli/index.ts list --dir benchmark-harness/scenarios",
    "bench:validate": "node --import tsx benchmark-harness/src/cli/index.ts validate",
    "bench:run": "node --import tsx benchmark-harness/src/cli/index.ts run",
    "bench:pair": "node --import tsx benchmark-harness/src/cli/index.ts pair",
    "bench:report": "node --import tsx benchmark-harness/src/cli/index.ts report",
    "bench:help": "node --import tsx benchmark-harness/src/cli/index.ts --help",
    "bench:test": "node --import tsx --test benchmark-harness/tests/*.test.ts benchmark-harness/tests/**/*.test.ts",
    "bench:typecheck": "tsc --noEmit -p benchmark-harness/tsconfig.json",
    "bench:build": "cd benchmark-harness && npm run build"
  },
  "config": {
    "telemetryEndpoint": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAPro-Community/Orquestrador-Maestro.git"
  },
