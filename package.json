{
  "name": "@iapro/orquestrador-maestro-cli",
  "version": "0.4.4",
  "description": "CLI npm para instalar, atualizar, verificar e remover o Orquestrador Maestro no usuário atual, com catálogo público deduplicado de skills versionadas.",
  "bin": {
    "orquestrador-maestro": "bin/orquestrador-maestro.js"
  },
  "files": [
    "bin/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "codex/agents/",
    "codex/prompts/",
    "codex/skills/",
    "docs/",
    "home/AGENTS.md",
    "install.ps1",
    "install.sh",
    "orquestrador/*.json",
    "orquestrador/schemas/",
    "orquestrador/interaction/",
    "orquestrador/*.md",
    "orquestrador/*.ps1",
    "orquestrador/*.sh",
    "orquestrador/bin/",
    "orquestrador/lib/",
    "orquestrador/adapters/",
    "orquestrador/blueprints/",
    "orquestrador/personas/",
    "orquestrador/skills/",
    "runtime/",
    "benchmark-harness/src/",
    "benchmark-harness/scenarios/",
    "benchmark-harness/fixtures/",
    "benchmark-harness/tests/",
    "benchmark-harness/schemas/",
    "benchmark-harness/docs/",
    "benchmark-harness/package.json",
    "benchmark-harness/tsconfig.json",
    "benchmark-harness/.env.example",
    "scripts/*.js",
    "scripts/*.py",
    "scripts/*.ps1",
    "scripts/*.sh",
    "skill-library/MANIFEST.json",
    "skill-library/PUBLIC_SKILLS_MANIFEST.json",
    "skill-library/community-skills/",
    "tool-profiles/",
    "README.md"
  ],
  "scripts": {
    "audit": "node scripts/audit-dependencies.js audit",
    "outdated:all": "node scripts/audit-dependencies.js outdated",
    "pack:dry-run": "npm pack --dry-run",
    "test": "node scripts/run-tests.js",
    "test:smoke": "node scripts/test-smoke.js",
    "test:xkiro": "node scripts/test-xkiro.js",
    "verify:pr": "node scripts/verify-pr.js",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-public.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-skills.ps1",
    "bench:list": "node --import tsx benchmark-harness/src/cli/index.ts list --dir benchmark-harness/scenarios",
    "bench:validate": "node --import tsx benchmark-harness/src/cli/index.ts validate",
    "bench:run": "node --import tsx benchmark-harness/src/cli/index.ts run",
    "bench:pair": "node --import tsx benchmark-harness/src/cli/index.ts pair",
    "bench:report": "node --import tsx benchmark-harness/src/cli/index.ts report",
    "bench:help": "node --import tsx benchmark-harness/src/cli/index.ts --help",
    "bench:test": "node --import tsx --test benchmark-harness/tests/*.test.ts benchmark-harness/tests/**/*.test.ts",
    "bench:typecheck": "tsc --noEmit -p benchmark-harness/tsconfig.json",
    "bench:build": "cd benchmark-harness && npm run build"
  },
  "config": {
    "telemetryEndpoint": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAPro-Community/Orquestrador-Maestro.git"
  },
  "keywords": [
    "iapro",
    "orquestrador",
    "maestro",
    "ai-agents",
    "agent-orchestration",
    "codex",
    "claude-code",
    "opencode",
    "freebuff",
    "cursor",
    "gemini-cli",
    "grok-cli",
    "mimo-code",
    "kimi-code",
    "windsurf",
    "antigravity",
    "skills",
    "hooks"
  ],
  "author": "Grupo IAPro",
  "homepage": "https://github.com/IAPro-Community/Orquestrador-Maestro#readme",
  "bugs": {
    "url": "https://github.com/IAPro-Community/Orquestrador-Maestro/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@opentui/core": "^0.5.1",
    "node-pty": "^1.1.0"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "@xterm/headless": "^5.5.0",
    "node-notifier": "10.0.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "uuid": "11.1.1"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
