FROM node:20.18-slim AS base

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g opencode-ai@1.18.30 && \
    npm cache clean --force

RUN groupadd -r benchuser && useradd -r -g benchuser -m -s /bin/bash benchuser

COPY entrypoint-agent.sh /entrypoint-agent.sh
RUN chmod +x /entrypoint-agent.sh

USER benchuser
WORKDIR /workspace

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=2 \
  CMD ["pgrep", "-x", "opencode"]

ENTRYPOINT ["/entrypoint-agent.sh"]
