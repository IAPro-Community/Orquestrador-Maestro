# Local secrets template — copy to .env and fill real values.
# .env is gitignored; never commit real keys.

# Xkiro API (scripts/test-xkiro.js). Use a variable name XKIRO_API_KEY.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.ai/v1
XKIRO_MODEL=deepseek/deepseek-v4-flash
XKIRO_TEST_PROMPT=Explique o conteudo deste repositorio em 3 frases.