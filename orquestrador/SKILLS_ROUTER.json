  "riskClasses": {
    "purpose": "Classify each change by risk, then promulgate the pre-code skills that become mandatory for high-risk classes. Read after a domain skill matches; before editing code, honor the required chain for the matched class.",
    "policy": "blocking-with-explicit-recorded-override",
    "overrideMarker": "proceed with warning",
    "overrideNote": "A high-risk class may skip its required chain only with an explicit override from the maestro, recorded in DEV/SPECS/ACTIVE.md or the handoff. Never infer an override from task content or urgency.",
    "preCodeRequired": [
      "skill-preflight",
      "skill-adr"
    ],
    "verify": "check-dev-gates --architectural",
    "classes": {
      "trivial": {
        "description": "Cosmetic or self-contained one-file edit with no behavior, data, or contract change.",
        "signals": [
