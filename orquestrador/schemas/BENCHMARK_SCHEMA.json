{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orquestrador Maestro Benchmark Result v2",
  "description": "Schema for v2 benchmark run results with real agent execution",
  "type": "object",
  "required": ["benchmark", "condition", "run", "model", "driver", "repoCommit", "promptHash", "environment", "driverResult", "validation", "evidence", "metadata"],
  "properties": {
    "benchmark": {
      "type": "string",
      "description": "Scenario identifier (e.g., bug-fix-auth)"
    },
    "condition": {
      "type": "string",
      "enum": ["vanilla", "maestro-core"],
      "description": "Test condition"
    },
    "run": {
      "type": "integer",
      "minimum": 1,
      "description": "Run number for this scenario/condition"
    },
    "model": {
      "type": "string",
      "description": "AI model used (e.g., anthropic/claude-sonnet-4-20250514)"
    },
    "driver": {
      "type": "string",
      "description": "Driver used (e.g., opencode)"
    },
    "repoCommit": {
      "type": "string",
      "description": "Git commit SHA of the repository"
    },
    "promptHash": {
      "type": "string",
      "description": "SHA-256 hash of the task prompt"
    },
    "environment": {
      "type": "object",
      "required": ["os", "nodeVersion", "platform", "arch", "timestamp"],
      "properties": {
        "os": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "driverResult": {
      "type": "object",
      "required": ["exitCode", "stdout", "stderr", "durationMs"],
      "description": "Raw driver output",
      "properties": {
        "exitCode": {
          "type": "integer",
          "description": "Process exit code"
        },
        "stdout": {
          "type": "string",
          "description": "Standard output"
        },
        "stderr": {
          "type": "string",
          "description": "Standard error"
        },
        "durationMs": {
          "type": "integer",
          "description": "Execution duration in milliseconds"
        },
        "filesChanged": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files modified by the agent"
        },
        "usage": {
          "type": "object",
          "description": "Token usage metrics",
          "properties": {
            "inputTokens": { "type": ["integer", "null"] },
            "outputTokens": { "type": ["integer", "null"] },
            "totalTokens": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["testsPassed", "testsTotal", "exitCode"],
      "description": "Hidden test results",
      "properties": {
        "testsPassed": {
          "type": "integer",
          "description": "Number of tests passed"
        },
        "testsTotal": {
          "type": "integer",
          "description": "Total number of tests"
        },
        "exitCode": {
          "type": "integer",
          "description": "Test runner exit code"
        },
        "output": {
          "type": "string",
          "description": "Raw test output"
        },
        "tapOutput": {
          "type": "string",
          "description": "TAP format output"
        },
        "error": {
          "type": "string",
          "description": "Error message if tests failed to run"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["passed", "testsPassed", "testsTotal", "errors"],
      "description": "Evidence gate result",
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "Whether evidence gate passed"
        },
        "testsPassed": {
          "type": "integer",
          "description": "Number of hidden tests passed"
        },
        "testsTotal": {
          "type": "integer",
          "description": "Total number of hidden tests"
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Error messages if gate failed"
        },
        "publicClaimEligible": {
          "type": "boolean",
          "description": "Whether this result is eligible for public claims"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["durationMs", "retries", "notes"],
      "description": "Additional metadata",
      "properties": {
        "durationMs": {
          "type": "integer",
          "description": "Total execution duration in milliseconds"
        },
        "retries": {
          "type": "integer",
          "description": "Number of retries"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes"
        }
      }
    }
  }
}
