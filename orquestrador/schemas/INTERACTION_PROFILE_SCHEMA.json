{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maestro Interaction Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultProfile", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "defaultProfile": { "enum": ["default", "focus"] },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "focus"],
      "properties": {
        "default": { "$ref": "#/$defs/profile" },
        "focus": { "$ref": "#/$defs/profile" }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leadWithAction", "showProgress", "showCompletionEvidence", "maxVisibleItems", "suppressTangents", "nextAction", "errorFormat", "timeEstimate"],
      "properties": {
        "leadWithAction": { "type": "boolean" },
        "showProgress": { "type": "boolean" },
        "showCompletionEvidence": { "type": "boolean" },
        "maxVisibleItems": { "type": "integer", "minimum": 1 },
        "suppressTangents": { "type": "boolean" },
        "nextAction": { "enum": ["when-relevant", "when-required"] },
        "errorFormat": { "enum": ["standard", "cause-fix"] },
        "timeEstimate": { "enum": ["disabled", "telemetry-only"] }
      }
    }
  }
}
