{
  "schemaVersion": 1,
  "managedBy": "orquestrador-maestro",
  "policy": {
    "neverManage": ["auth", "sessions", "cache", "logs", "databases", "conversation-history", "secrets"],
    "defaultPermissionMode": "ask",
    "networkDetection": false
  },
  "adapters": {
    "junie": {"displayName": "Junie CLI", "surfaces": ["cli", "jetbrains", "acp", "ci"], "command": "junie", "config": {"global": ["~/.junie/config.json", "~/.junie/mcp", "~/.junie/skills", "~/.junie/commands", "~/.junie/agents"], "project": [".junie/config.json", ".junie/mcp", ".junie/skills", ".junie/commands", ".junie/agents"]}, "capabilities": ["plan", "review", "resume", "mcp", "skills", "agents", "acp"]},
    "goose": {"displayName": "Goose", "surfaces": ["cli", "desktop", "api", "acp"], "command": "goose", "config": {"global": ["%APPDATA%/Block/goose/config/config.yaml", "~/.config/goose/config.yaml", "~/.agents/skills"], "project": [".agents/skills", ".goose/skills"]}, "capabilities": ["mcp", "skills", "extensions", "permissions", "acp"]},
    "openhands": {"displayName": "OpenHands", "surfaces": ["cli", "sdk", "headless", "sandbox"], "command": "openhands", "config": {"global": ["~/.openhands/agent_settings.json", "~/.openhands/cli_config.json", "~/.openhands/mcp.json", "~/.agents/agents", "~/.openhands/agents", "~/.agents/skills"], "project": [".agents/agents", ".openhands/agents", ".agents/skills", ".openhands/skills", ".openhands/mcp.json"]}, "capabilities": ["headless", "jsonl", "resume", "mcp", "sandbox", "sdk", "agents", "skills"]},
    "continue": {"displayName": "Continue", "surfaces": ["cli", "vscode", "jetbrains"], "command": "cn", "config": {"global": ["%USERPROFILE%/.continue/config.yaml", "~/.continue/config.yaml"], "project": [".continue/config.yaml", ".continue/rules"]}, "capabilities": ["models", "rules", "prompts", "docs", "mcp"]},
    "cline": {"displayName": "Cline", "surfaces": ["cli", "vscode", "jetbrains", "sdk"], "command": "cline", "config": {"global": ["~/.cline", "~/Documents/Cline/Rules"], "project": [".cline", ".clinerules"]}, "capabilities": ["plan", "act", "rules", "skills", "hooks", "agents", "mcp", "checkpoints"]},
    "copilot": {"displayName": "GitHub Copilot CLI", "surfaces": ["cli", "vscode", "jetbrains", "github"], "command": "copilot", "config": {"global": ["~/.copilot/settings.json", "~/.copilot/agents", "~/.copilot/skills", "~/.copilot/hooks"], "project": [".github/agents", ".github/skills", ".github/hooks", ".agents/skills"]}, "capabilities": ["plan", "autopilot", "agents", "skills", "hooks", "mcp", "lsp"]},
    "ollama": {"displayName": "Ollama", "surfaces": ["local-provider", "cli", "api"], "command": "ollama", "config": {"global": ["OLLAMA_HOST", "OLLAMA_MODELS"], "project": []}, "capabilities": ["local-models", "openai-compatible-api"]},
    "lm-studio": {"displayName": "LM Studio", "surfaces": ["local-provider", "desktop", "cli", "api"], "command": "lms", "config": {"global": ["LM_STUDIO_API_BASE"], "project": []}, "capabilities": ["local-models", "openai-compatible-api", "anthropic-compatible-api", "mcp"]},
    "freebuff": {"displayName": "Freebuff", "surfaces": ["cli", "desktop", "sdk"], "command": "freebuff", "config": {"global": ["~/AGENTS.md", "~/.agents/skills"], "project": ["AGENTS.md", "knowledge.md", ".agents/skills", ".agents/agents", ".agents/mcp.json", ".freebuffrc"]}, "capabilities": ["local-execution", "skills", "agents", "subagents", "mcp", "sdk"], "notes": "Usa o contrato compartilhado AGENTS.md/.agents; autenticação, sessões, cache, logs e histórico permanecem sob controle do Freebuff."}
  }
}
