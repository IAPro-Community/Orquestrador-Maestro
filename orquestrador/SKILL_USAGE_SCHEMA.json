{
  "version": 2,
  "logPath": "{{USER_HOME}}/.orquestrador/logs/skill-usage.jsonl",
  "purpose": "Append-only JSONL schema for measuring skill invocation, routing decisions and token discipline in Maestro V1.",
  "requiredFields": [
    "timestamp",
    "tool",
    "profile",
    "task",
    "selectedSkills",
    "openedSkills",
    "openedReferences",
    "result",
    "notes"
  ],
  "optionalFields": [
    "workflow",
    "provenance"
  ],
  "fieldSchemas": {
    "workflow": {
      "entry": "SKILL.md",
      "kind": "task",
      "validation": "standard",
      "referencesOptional": true,
      "notes": "Resolved workflow metadata after manifest defaults and per-skill overrides are applied."
    },
    "provenance": {
      "evidence": [
        "orquestrador/SKILLS_MANIFEST.json"
      ],
      "steward": "orquestrador-maintainers",
      "reviewedAt": "2026-09-22",
      "notes": "Resolved provenance metadata after manifest defaults and per-skill overrides are applied."
    }
  },
  "example": {
    "timestamp": "2026-05-12T00:00:00-03:00",
    "tool": "codex",
    "profile": "standard",
    "task": "build SaaS admin dashboard with Stripe",
    "selectedSkills": [
      "skill-saas-factory",
      "skill-stripe-integration",
      "skill-saas-admin-dashboard"
    ],
    "openedSkills": [
      "skill-saas-factory",
      "skill-stripe-integration"
    ],
    "openedReferences": [],
    "result": "completed",
    "notes": "Loaded two skills; dashboard skill not opened because SaaS factory covered the needed workflow.",
    "workflow": {
      "entry": "SKILL.md",
      "kind": "task",
      "validation": "standard",
      "referencesOptional": true,
      "notes": "Resolved from manifest defaults."
    },
    "provenance": {
      "evidence": [
        "orquestrador/SKILLS_MANIFEST.json"
      ],
      "steward": "orquestrador-maintainers",
      "reviewedAt": "2026-08-06",
      "notes": "Resolved from manifest defaults."
    }
  }
}
