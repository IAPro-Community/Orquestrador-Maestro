{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orquestrador.local/schemas/skills-manifest.schema.json",
  "title": "Orquestrador Maestro Skills Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "purpose",
    "skills"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "schema": {
      "type": "string",
      "const": "./SKILLS_MANIFEST_SCHEMA.json"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        }
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "pattern": "^skill-[a-z0-9][a-z0-9-]{0,58}[a-z0-9]$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/skillEntry"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "steward",
        "reviewedAt"
      ],
      "properties": {
        "evidence": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "steward": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upstream": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bestFor",
        "examples",
        "prerequisites"
      ],
      "properties": {
        "bestFor": {
          "$ref": "#/$defs/stringList"
        },
        "examples": {
          "$ref": "#/$defs/stringList"
        },
        "prerequisites": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "kind"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
        },
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "workflow",
            "reference"
          ]
        },
        "referencesOptional": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "skillEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "category",
        "risk",
        "source",
        "mirrorEverywhere",
        "aliases",
        "tags",
        "routerSummary",
        "documentation",
        "provenance",
        "schemaVersion",
        "contractVersion",
        "origin",
        "maturity",
        "capabilities",
        "routing",
        "context",
        "outputs",
        "verification",
        "costProfile"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mirrorEverywhere": {
          "type": "boolean"
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "routerSummary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "documentation": {
          "$ref": "#/$defs/documentation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "schemaVersion": {
          "const": 2
        },
        "contractVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "origin": {
          "type": "string",
          "enum": [
            "maestro-core",
            "maestro-domain"
          ]
        },
        "maturity": {
          "type": "string",
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ai-integration",
              "analytics",
              "api-design",
              "architecture",
              "browser-automation",
              "build-tooling",
              "ci",
              "communication",
              "compliance",
              "containers",
              "database",
              "debugging",
              "delivery",
              "developer-environment",
              "documentation",
              "engineering",
              "frontend",
              "git",
              "governance",
              "integrations",
              "issue-resolution",
              "kubernetes",
              "legacy-modernization",
              "maintenance",
              "marketing",
              "media",
              "observability",
              "operations",
              "orchestration",
              "payments",
              "performance",
              "pull-request",
              "quality",
              "refactoring",
              "research",
              "saas",
              "security",
              "testing",
              "verification",
              "workflow"
            ]
          }
        },
        "routing": {
          "$ref": "#/$defs/skillContractRouting"
        },
        "context": {
          "$ref": "#/$defs/skillContractContext"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "verification": {
          "$ref": "#/$defs/skillContractVerification"
        },
        "costProfile": {
          "$ref": "#/$defs/skillContractCostProfile"
        }
      }
    },
    "skillContractRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "useWhen",
        "doNotUseWhen"
      ],
      "properties": {
        "useWhen": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "doNotUseWhen": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "skillContractContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "useful",
        "avoid"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/stringList"
        },
        "useful": {
          "$ref": "#/$defs/stringList"
        },
        "avoid": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "skillContractVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "requirements"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "strict"
          ]
        },
        "requirements": {
          "allOf": [
            {
              "$ref": "#/$defs/stringList"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "skillContractCostProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context"
      ],
      "properties": {
        "context": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
