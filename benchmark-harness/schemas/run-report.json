{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkRunReport",
  "description": "Complete report for a single benchmark run.",
  "type": "object",
  "required": ["runId", "scenarioId", "condition", "driver", "fixture", "status", "results", "tokens", "timing", "evidence"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string", "format": "uuid" },
    "scenarioId": { "type": "string" },
    "condition": { "type": "string", "enum": ["vanilla", "maestro", "maestro-focus"] },
    "driver": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "taskHash": { "type": "string", "description": "SHA-256 of the task prompt" },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "container": { "type": "boolean" },
        "containerImage": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "isolated": { "type": "boolean" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "timeout", "error", "skipped", "benchmark-integrity-violation"]
    },
    "failureType": {
      "type": "string",
      "description": "Set when status is failed/error/integrity-violation"
    },
    "results": {
      "type": "object",
      "required": ["acceptanceRate", "criteria"],
      "properties": {
        "acceptanceRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "accepted": { "type": "boolean" },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name", "passed"],
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "passed": { "type": "boolean" },
              "duration": { "type": "integer" },
              "output": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "input": { "type": ["integer", "null"] },
        "output": { "type": ["integer", "null"] },
        "reasoning": { "type": ["integer", "null"] },
        "cacheRead": { "type": ["integer", "null"] },
        "cacheWrite": { "type": ["integer", "null"] },
        "total": { "type": ["integer", "null"] },
        "source": {
          "type": "string",
          "enum": ["provider-reported", "opencode-native", "session-derived", "tokenizer-exact", "tokenizer-estimated", "unavailable"]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "reliable", "estimated", "unavailable"]
        },
        "rawEvidenceRef": { "type": "string" }
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "startMs": { "type": "integer" },
        "endMs": { "type": "integer" },
        "durationMs": { "type": "integer" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["rawDir", "agentOutput", "verifierOutput"],
      "properties": {
        "rawDir": { "type": "string" },
        "agentOutput": { "type": "string" },
        "verifierOutput": { "type": "string" },
        "agentExitCode": { "type": "integer" },
        "verifierExitCode": { "type": "integer" },
        "filesChanged": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gitDiff": { "type": "string" },
        "sessionFile": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
