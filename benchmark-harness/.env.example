# Benchmark Harness — Environment Variables
# Copy to .env and fill in your credentials

# ── Provider ──────────────────────────────────────────
# API key for the agent provider (OpenAI, Anthropic, DeepSeek, etc.)
BENCHMARK_API_KEY=

# Base URL for the provider API (leave empty for default)
# DeepSeek:   https://api.deepseek.com
# OpenAI:     https://api.openai.com/v1
# Anthropic:  https://api.anthropic.com
# Local:      http://localhost:11434/v1
BENCHMARK_BASE_URL=

# ── Model ─────────────────────────────────────────────
# Model identifier to use in benchmarks
# DeepSeek:   deepseek-chat | deepseek-reasoner
# OpenAI:     gpt-4o | gpt-4o-mini | o1
# Anthropic:  claude-sonnet-4-20250514 | claude-haiku-4-20250514
BENCHMARK_MODEL=deepseek-chat

# ── Agent ─────────────────────────────────────────────
# Path to the agent binary (default: opencode)
# BENCHMARK_AGENT_PATH=opencode

# ── Execution ─────────────────────────────────────────
# Timeout per run in milliseconds (default: 300000 = 5min)
# BENCHMARK_TIMEOUT=300000

# Container settings (for official benchmarks)
# BENCHMARK_CONTAINER=true
# BENCHMARK_CONTAINER_IMAGE=node:20-slim
# BENCHMARK_MEMORY_LIMIT=4g
# BENCHMARK_NETWORK_MODE=none
