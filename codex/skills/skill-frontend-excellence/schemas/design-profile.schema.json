{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./design-profile.schema.json",
  "title": "Application Design Profile",
  "description": "Product identity and agent policy. It is not a duplicate of a design-system catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product", "designSystem", "design"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["authentication", "admin", "portal", "marketing", "embedded", "tooling"]
        },
        "description": { "type": "string" }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "themeDefault": { "type": "string" },
        "themeStorageKey": { "type": "string" },
        "metadataSource": { "type": "string" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creativity", "personality"],
      "properties": {
        "creativity": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "personality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "productive",
              "dense",
              "clear",
              "modern",
              "welcoming",
              "visual",
              "experimental",
              "trustworthy",
              "editorial",
              "playful"
            ]
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "generic-saas",
              "excessive-gradients",
              "excessive-glassmorphism",
              "metric-card-overload",
              "unnecessary-sidebar",
              "low-contrast-gray-text",
              "giant-radius",
              "shadow-excess"
            ]
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": { "type": "string", "enum": ["compact", "medium", "comfortable"] },
        "mobileFirst": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard": { "type": "string", "enum": ["WCAG-AA", "WCAG-AAA"] }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 320 }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentLibrary": { "type": "string" },
        "styling": { "type": "string", "enum": ["scss-modules", "scss", "css", "tailwind", "mixed"] },
        "importStyle": { "type": "string", "enum": ["namespace", "barrel", "compat-layer"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultPosture": { "type": "string", "enum": ["preserve", "evolve", "explore"] },
        "unsolicitedRedesign": { "type": "string", "enum": ["forbidden", "ask"] }
      }
    }
  }
}
